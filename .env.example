# Copie ces variables dans l'onglet « Environment variables » de ton hébergeur.
# Ne mets JAMAIS ce fichier rempli sur GitHub.

# Secrets : 32 caractères aléatoires chacun (lettres et chiffres)
WEBHOOK_SECRET=
BRIDGE_KEY=
DASHBOARD_KEY=

# Bot Telegram (créé avec @BotFather) et ton identifiant de discussion
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Adresse publique du serveur, sans / à la fin (sert aux liens de validation)
PUBLIC_URL=

# Compte et règles du Sniper System (vérifie les limites exactes de ton compte FTMO)
ACCOUNT_SIZE=40000
ACCOUNT_CURRENCY=EUR
RISK_PCT=1
MIN_RR=2
MAX_DAILY_LOSS_PCT=5
MAX_LOSS_PCT=10
DAILY_BUFFER_PCT=1
MAX_OPEN=2
NO_MONDAY=true
ALLOWED_SYMBOLS=XAUUSD,EURUSD,BTCUSD
TIMEZONE=Europe/Paris
SIGNAL_TTL_MIN=30
# SYMBOL_MAP={"XAUUSD":"XAUUSD"}
# NEWS_BLOCKS=[{"from":"2026-11-14T14:15:00+01:00","to":"2026-11-14T14:45:00+01:00","label":"CPI US"}]

# Exécution : off (aucun ordre), demo (compte d'essai), live (compte réel).
# Les ordres ne partent QUE vers le numéro de compte EXECUTION_LOGIN.
EXECUTION_MODE=off
EXECUTION_LOGIN=

DATA_DIR=./data
